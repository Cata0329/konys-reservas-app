# Copia este archivo como .env y reemplaza los valores de ejemplo.
# NUNCA pongas aquí la clave service_role / sb_secret_.

# Supabase → Project Settings → API (o "Connect") → Project URL
SUPABASE_URL=https://tu-proyecto-ejemplo.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
# o, en proyectos antiguos, la clave "anon public".
SUPABASE_PUBLISHABLE_KEY=sb_publishable_EJEMPLO_reemplazar_por_la_clave_real

# Correo del usuario administrador creado en Supabase → Authentication → Users.
# El panel solo pide la contraseña (como en el diseño); este correo identifica la cuenta.
ADMIN_EMAIL=admin@ejemplo.com

# Opcionales: se muestran en el pie de página si tienen valor.
CONTACTO_WHATSAPP=
CONTACTO_INSTAGRAM=
