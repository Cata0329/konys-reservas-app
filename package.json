{
  "name": "konys-reservas-app",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de reservas de Konys Pizza (HTML, CSS, JavaScript y Supabase)",
  "type": "module",
  "scripts": {
    "config": "node scripts/generar-config.mjs",
    "config:pruebas": "node scripts/generar-config.mjs --pruebas",
    "dev": "node scripts/generar-config.mjs && node scripts/servidor-local.mjs",
    "servidor": "node scripts/servidor-local.mjs",
    "supabase:pruebas": "node tests/soporte/supabase-local.mjs",
    "menu:extraer": "node scripts/extraer-menu-konys.mjs",
    "menu:sql": "node scripts/generar-sql-catalogo.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:selenium": "py -X utf8 tests/selenium/ejecutar.py"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17"
  }
}
